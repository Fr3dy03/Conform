# BOT Chain testnet only. All values are read on the server by Next.js route handlers.
# Do not put private keys, seed phrases, or provider API keys in NEXT_PUBLIC_* variables.

BOT_TESTNET_RPC_URL=https://rpc.bohr.life
BOT_TESTNET_BUNDLER_URL=https://bundler.bohr.life/rpc/
BOT_TESTNET_EXPLORER_URL=https://scan.bohr.life
BOT_TESTNET_FAUCET_URL=https://faucet.botchain.ai/basic

# Verified against https://dev-docs.botchain.ai/docs/Account-Abstraction/network-and-endpoints
BOT_TESTNET_ENTRYPOINT=0x0000000071727De22E5E9d8BAf0edAc6f37da032
BOT_TESTNET_SIMPLE_ACCOUNT_FACTORY=0xBC88d6012b3bf8426C2851d3798cEB5257658332
BOT_TESTNET_SIMPLE_ACCOUNT_IMPLEMENTATION=0xDE15Ab00C52FF37eCe01C384eB42C802721db823

# Optional. Leave empty unless you have independently verified a BOT-compatible
# EntryPoint v0.7 paymaster. Conform will report sponsorship as "unknown" when empty.
BOT_TESTNET_PAYMASTER_ADDRESS=

# Public site origin used for canonical URLs and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
